# Generated by packaging/homebrew/formula.sh for rustcdc @VERSION@; do not edit.
class Rustcdc < Formula
  desc "Change data capture server: PostgreSQL, MySQL, MariaDB and SQL Server to Kafka and more"
  homepage "https://hupe1980.github.io/rustcdc/"
  license any_of: ["MIT", "Apache-2.0"]

  on_macos do
    on_arm do
      url "https://github.com/hupe1980/rustcdc/releases/download/v@VERSION@/rustcdc-darwin-aarch64.tar.gz"
      sha256 "@SHA256_rustcdc-darwin-aarch64@"
    end
  end

  on_linux do
    on_arm do
      url "https://github.com/hupe1980/rustcdc/releases/download/v@VERSION@/rustcdc-linux-aarch64.tar.gz"
      sha256 "@SHA256_rustcdc-linux-aarch64@"
    end
    on_intel do
      url "https://github.com/hupe1980/rustcdc/releases/download/v@VERSION@/rustcdc-linux-x86_64.tar.gz"
      sha256 "@SHA256_rustcdc-linux-x86_64@"
    end
  end

  def install
    # Each archive holds one binary named after its platform.
    bin.install Dir["rustcdc-*"].first => "rustcdc"
  end

  def caveats
    <<~EOS
      Create a configuration, check it, run it:
        rustcdc init --output cdc.toml --profile dev
        rustcdc validate-config --config-file cdc.toml
        rustcdc run --config-file cdc.toml
      Getting started: https://hupe1980.github.io/rustcdc/docs/getting-started/
    EOS
  end

  test do
    assert_match "rustcdc #{version}", shell_output("#{bin}/rustcdc --version")
  end
end
