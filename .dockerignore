# ── build artefacts ──────────────────────────────────────────────────────────
target/

# ── version control ──────────────────────────────────────────────────────────
.git/
.gitignore
.gitattributes

# ── CI / tooling config (not needed inside the image) ────────────────────────
.github/
.cargo/
deny.toml
rust-toolchain.toml

# ── documentation ─────────────────────────────────────────────────────────────
site/
README.md
REVIEW.md
FINDINGS.md
# LICENSE-MIT / LICENSE-APACHE are deliberately NOT excluded — they are copied
# into the runtime image.

# ── monitoring rules (not part of the binary) ────────────────────────────────
monitoring/

# ── local dev cruft ──────────────────────────────────────────────────────────
**/*.log
**/*.tmp
.DS_Store
*.swp
*.swo
