# ── build artefacts ──────────────────────────────────────────────────────────
target/

# ── version control ──────────────────────────────────────────────────────────
.git/
.gitignore
.gitattributes

# ── CI / tooling config (not needed inside the image) ────────────────────────
.github/
.cargo/
deny.toml
rust-toolchain.toml

# ── documentation ─────────────────────────────────────────────────────────────
docs/
README.md
REVIEW.md
FINDINGS.md
LICENSE

# ── monitoring rules (not part of the binary) ────────────────────────────────
monitoring/

# ── local dev cruft ──────────────────────────────────────────────────────────
**/*.log
**/*.tmp
.DS_Store
*.swp
*.swo
