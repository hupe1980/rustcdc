{
  "type": "record",
  "name": "Event",
  "namespace": "io.rustcdc",
  "doc": "Canonical CDC event envelope \u2014 rustcdc envelope_version=1",
  "fields": [
    {
      "name": "before",
      "type": [
        "null",
        "bytes"
      ],
      "default": null,
      "doc": "JSON-encoded before-image. null for INSERT events, and for UPDATE events whose source supplied no pre-image (PostgreSQL REPLICA IDENTITY DEFAULT when no key column changed). Read with before_is_key_only: absent, key-only and complete are three different states, and only the third is a row."
    },
    {
      "name": "after",
      "type": [
        "null",
        "bytes"
      ],
      "default": null,
      "doc": "JSON-encoded after-image. null for DELETE events."
    },
    {
      "name": "op",
      "type": {
        "type": "enum",
        "name": "Operation",
        "namespace": "io.rustcdc",
        "symbols": [
          "INSERT",
          "UPDATE",
          "DELETE",
          "READ",
          "SCHEMA_CHANGE",
          "TRUNCATE",
          "MESSAGE"
        ],
        "doc": "CRUD operation that produced this event."
      }
    },
    {
      "name": "source",
      "type": {
        "type": "record",
        "name": "SourceMetadata",
        "namespace": "io.rustcdc",
        "fields": [
          {
            "name": "source_name",
            "type": "string",
            "doc": "Logical connector name"
          },
          {
            "name": "offset",
            "type": "string",
            "doc": "Source-specific durable position"
          },
          {
            "name": "timestamp",
            "type": "long",
            "doc": "Source timestamp in ms since epoch"
          }
        ]
      }
    },
    {
      "name": "ts",
      "type": "long",
      "doc": "Event timestamp in milliseconds since Unix epoch."
    },
    {
      "name": "schema",
      "type": [
        "null",
        "string"
      ],
      "default": null,
      "doc": "Database schema name. null when unknown."
    },
    {
      "name": "table",
      "type": "string",
      "doc": "Table name that produced the event."
    },
    {
      "name": "primary_key",
      "type": {
        "type": "array",
        "items": "string"
      },
      "default": [],
      "doc": "Ordered list of primary key column names."
    },
    {
      "name": "snapshot",
      "type": [
        "null",
        {
          "type": "record",
          "name": "SnapshotMetadata",
          "namespace": "io.rustcdc",
          "fields": [
            {
              "name": "snapshot_id",
              "type": "string"
            },
            {
              "name": "chunk_index",
              "type": "int"
            },
            {
              "name": "is_last_chunk",
              "type": "boolean"
            }
          ]
        }
      ],
      "default": null,
      "doc": "Snapshot phase metadata. null outside snapshot."
    },
    {
      "name": "transaction",
      "type": [
        "null",
        {
          "type": "record",
          "name": "TransactionMetadata",
          "namespace": "io.rustcdc",
          "fields": [
            {
              "name": "tx_id",
              "type": "long"
            },
            {
              "name": "total_events",
              "type": "int"
            },
            {
              "name": "event_index",
              "type": "int"
            }
          ]
        }
      ],
      "default": null,
      "doc": "Transaction metadata. null for single-event transactions."
    },
    {
      "name": "envelope_version",
      "type": "int",
      "default": 1,
      "doc": "Canonical envelope schema version. Currently always 1."
    },
    {
      "name": "before_is_key_only",
      "type": "boolean",
      "default": false,
      "doc": "True when 'before' contains only primary-key columns (PostgreSQL DEFAULT REPLICA IDENTITY). Always false for non-UPDATE or non-PostgreSQL events."
    },
    {
      "name": "unavailable_columns",
      "type": {
        "type": "array",
        "items": "string"
      },
      "default": [],
      "doc": "Columns absent from 'after' because the source could not supply them (PostgreSQL unchanged-TOAST). Absent, not null: a consumer writing whole rows must exclude them rather than writing NULL over an unchanged value. REPLICA IDENTITY FULL does not avoid this."
    },
    {
      "name": "before_unavailable_columns",
      "type": {
        "type": "array",
        "items": "string"
      },
      "default": [],
      "doc": "The same, for 'before'. Never merged with unavailable_columns: the two sets differ, and merging them marks genuinely-changed columns as unwritable."
    },
    {
      "name": "shape",
      "type": [
        "null",
        {
          "type": "record",
          "name": "RowShape",
          "doc": "The table shape this row was captured under. Complete when 'columns' and 'primary_key' are present; compact (only 'id', resolved elsewhere) when both are null.",
          "fields": [
            {
              "name": "id",
              "type": "string",
              "doc": "Lowercase hex SHA-256 of 'rustcdc/v2/row-shape' followed by the length-prefixed schema, table, columns and primary key."
            },
            {
              "name": "schema",
              "type": "string",
              "doc": "Schema (PostgreSQL schema, MySQL database, SQL Server schema) as the source names it."
            },
            {
              "name": "table",
              "type": "string",
              "doc": "Table as the source names it; not renamed by a route transform."
            },
            {
              "name": "columns",
              "type": [
                "null",
                {
                  "type": "array",
                  "items": {
                    "type": "record",
                    "name": "ShapeColumn",
                    "fields": [
                      {"name": "name", "type": "string", "doc": "Column name."},
                      {"name": "data_type", "type": "string", "doc": "Declared type in the source's own syntax, modifier included."},
                      {"name": "nullable", "type": "boolean", "doc": "Whether the column accepts NULL, as the source's catalogue declares it."}
                    ]
                  }
                }
              ],
              "default": null,
              "doc": "Columns in ordinal order; null for a compact shape."
            },
            {
              "name": "primary_key",
              "type": ["null", {"type": "array", "items": "string"}],
              "default": null,
              "doc": "Primary-key column names in key order; empty for a keyless table, null for a compact shape."
            }
          ]
        }
      ],
      "default": null,
      "doc": "The table shape this row was captured under: columns with declared types and nullability, the primary key, and a content id. Column values are JSON text, so the declared type is what says how to parse them. null when the connector cannot vouch for the shape the row was captured under, and after a transform that changed the columns' meaning: null means unknown."
    }
  ]
}
